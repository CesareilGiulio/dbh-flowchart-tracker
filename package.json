{
  "name": "flowchart-tracker",
  "productName": "Flowchart Tracker",
  "version": "1.0.1",
  "description": "Unofficial offline tracker for the Detroit: Become Human flowcharts / Tracker non ufficiale dei diagrammi di Detroit: Become Human",
  "main": "main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.flowchart-tracker",
    "productName": "Flowchart Tracker",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "data/manual/**",
      "build/icon.png"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "FlowchartTracker.exe"
    }
  }
}
